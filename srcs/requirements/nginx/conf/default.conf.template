# Serve the WordPress website over HTTPS.
server {
    # Accept encrypted connections on the project's only public port.
    listen 443 ssl;

    # The entrypoint replaces this placeholder with your configured domain.
    server_name ${DOMAIN_NAME};

    # Use the certificate and private key generated by the entrypoint.
    ssl_certificate /etc/nginx/tls/site.crt;
    ssl_certificate_key /etc/nginx/tls/site.key;

    # Allow only the TLS versions required by the subject.
    ssl_protocols TLSv1.2 TLSv1.3;

    # Read website files from the shared WordPress named volume.
    root /var/www/html;

    # Use WordPress's front controller when a directory is requested.
    index index.php;

    # Allow request bodies up to 16 MB; PHP also has separate upload limits.
    client_max_body_size 16m;

    # Block direct requests for WordPress's configuration file.
    location = /wp-config.php {
        return 404;
    }

    # Hide dotfiles, including the persistent authentication-salts file.
    location ~ /\. {
        deny all;
    }

    # Prevent uploaded PHP files from being executed or served.
    location ~* ^/wp-content/uploads/.*\.php(?:/|$) {
        return 403;
    }

    # Serve existing files and directories, or let WordPress handle the URL.
    location / {
        # Preserve query parameters when forwarding to the front controller.
        try_files $uri $uri/ /index.php?$args;
    }

    # Send PHP scripts, including health.php, to the PHP-FPM container.
    location ~ \.php$ {
        # Reject nonexistent scripts before contacting PHP-FPM.
        try_files $uri =404;

        # Supply the standard FastCGI request parameters.
        include /etc/nginx/fastcgi_params;

        # Tell PHP-FPM which file to execute inside the shared website directory.
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;

        # Tell PHP that the original browser connection used HTTPS.
        fastcgi_param HTTPS on;

        # Prevent a client Proxy header from becoming PHP's HTTP_PROXY variable.
        fastcgi_param HTTP_PROXY "";

        # Resolve the WordPress service through Docker DNS and connect to FPM.
        fastcgi_pass wordpress:9000;
    }
}
